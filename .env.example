# Copy to .env and fill in real values for anything beyond local/offline testing.

# --- Database ---
DB_NAME=smartdental
DB_USERNAME=smartdental
DB_PASSWORD=smartdental
DB_PORT=5432
JPA_DDL_AUTO=update

# --- Server / CORS ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AWS SES ---
AWS_REGION=us-east-1
SES_SENDER_EMAIL=no-reply@smartdental.example.com
SES_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI translation (OpenAI or Gemini) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TRANSLATION_ENABLED=false

# --- Seed data ---
SEED_DATA_ENABLED=true
